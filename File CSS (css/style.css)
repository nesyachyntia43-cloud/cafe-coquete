/* Reset dan Global Styles */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

:root {
    --pink-light: #FFF0F5;
    --pink: #FFB6C1;
    --pink-dark: #FF69B4;
    --pink-rose: #FF1493;
    --white: #FFFFFF;
    --cream: #FFF5EE;
    --cream-dark: #FFE4E1;
    --text-dark: #4A4A4A;
    --text-light: #8B7D7D;
    --border-color: #FFD1DC;
    --shadow: 0 2px 15px rgba(255, 105, 180, 0.1);
    --shadow-hover: 0 5px 25px rgba(255, 105, 180, 0.2);
}

body {
    font-family: 'Segoe UI', 'Helvetica Neue', 'Arial', sans-serif;
    line-height: 1.6;
    color: var(--text-dark);
    background-color: var(--cream);
    background-image: 
        radial-gradient(circle at 20% 50%, rgba(255, 182, 193, 0.05) 0%, transparent 50%),
        radial-gradient(circle at 80% 50%, rgba(255, 182, 193, 0.05) 0%, transparent 50%);
}

.container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
}

/* Ornamen dan Dekorasi */
.ornament-ribbon {
    position: relative;
    text-align: center;
    margin: 2rem 0;
}

.ornament-ribbon::before,
.ornament-ribbon::after {
    content: '🎀';
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    font-size: 1.5rem;
}

.ornament-ribbon::before {
    left: 10%;
}

.ornament-ribbon::after {
    right: 10%;
}

.heart-decoration {
    display: inline-block;
    color: var(--pink);
    animation: heartbeat 1.5s ease-in-out infinite;
}

@keyframes heartbeat {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.1); }
}

@keyframes float {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-10px); }
}

/* Header dan Navigasi */
header {
    background: linear-gradient(135deg, var(--pink-light) 0%, var(--white) 100%);
    border-bottom: 2px solid var(--border-color);
    padding: 1rem 0;
    position: sticky;
    top: 0;
    z-index: 1000;
    box-shadow: 0 2px 10px rgba(255, 105, 180, 0.1);
}

nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
}

.logo {
    font-size: 1.8rem;
    font-weight: bold;
    text-decoration: none;
    color: var(--pink-dark);
    position: relative;
}

.logo::after {
    content: '♡';
    position: absolute;
    top: -10px;
    right: -20px;
    font-size: 1rem;
    color: var(--pink-rose);
}

.nav-links {
    display: flex;
    gap: 2rem;
    list-style: none;
}

.nav-links a {
    color: var(--text-dark);
    text-decoration: none;
    font-weight: 500;
    transition: all 0.3s;
    position: relative;
    padding: 0.5rem 0;
}

.nav-links a::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 2px;
    background: var(--pink);
    transition: width 0.3s;
}

.nav-links a:hover {
    color: var(--pink-dark);
}

.nav-links a:hover::after {
    width: 100%;
}

/* Hero Section */
.hero {
    background: linear-gradient(135deg, var(--pink-light) 0%, var(--white) 50%, var(--cream-dark) 100%);
    padding: 5rem 0;
    text-align: center;
    position: relative;
    overflow: hidden;
}

.hero::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-image: 
        url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M30 15 Q35 5 40 15 Q45 25 40 35 Q35 45 30 35 Q25 25 20 15 Q25 5 30 15Z' fill='%23FFB6C1' fill-opacity='0.1'/%3E%3C/svg%3E");
    opacity: 0.5;
    pointer-events: none;
}

.hero h1 {
    font-size: 3rem;
    color: var(--pink-dark);
    margin-bottom: 1rem;
    position: relative;
    z-index: 1;
}

.hero p {
    font-size: 1.2rem;
    color: var(--text-light);
    margin-bottom: 2rem;
    position: relative;
    z-index: 1;
}

.hero-subtitle {
    font-style: italic;
    color: var(--pink-rose);
}

/* Buttons */
.btn {
    display: inline-block;
    padding: 0.8rem 2rem;
    border-radius: 25px;
    text-decoration: none;
    font-weight: 600;
    transition: all 0.3s;
    cursor: pointer;
    border: none;
    font-size: 1rem;
    position: relative;
    overflow: hidden;
}

.btn-primary {
    background: linear-gradient(135deg, var(--pink) 0%, var(--pink-dark) 100%);
    color: var(--white);
    box-shadow: 0 4px 15px rgba(255, 105, 180, 0.3);
}

.btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(255, 105, 180, 0.4);
}

.btn-secondary {
    background: var(--white);
    color: var(--pink-dark);
    border: 2px solid var(--pink);
}

.btn-secondary:hover {
    background: var(--pink-light);
    transform: translateY(-2px);
}

/* Featured Menu Section */
.featured-menu {
    margin: 4rem 0;
    position: relative;
}

.featured-menu h2 {
    text-align: center;
    color: var(--pink-dark);
    margin-bottom: 1rem;
    font-size: 2rem;
}

.menu-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
    padding: 2rem 0;
}

.menu-card {
    background: var(--white);
    border-radius: 20px;
    box-shadow: var(--shadow);
    overflow: hidden;
    transition: all 0.3s;
    border: 2px solid transparent;
}

.menu-card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-hover);
    border-color: var(--pink);
}

.menu-image {
    width: 100%;
    height: 250px;
    object-fit: cover;
    background: linear-gradient(135deg, var(--pink-light), var(--cream));
}

.menu-info {
    padding: 1.5rem;
    position: relative;
}

.menu-info::before {
    content: '♡';
    position: absolute;
    top: -15px;
    right: 15px;
    background: var(--white);
    width: 30px;
    height: 30px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--pink-rose);
    font-size: 1.2rem;
    box-shadow: var(--shadow);
}

.menu-info h3 {
    color: var(--pink-dark);
    margin-bottom: 0.5rem;
    font-size: 1.3rem;
}

.menu-category {
    display: inline-block;
    background: var(--pink-light);
    color: var(--pink-dark);
    padding: 0.3rem 1rem;
    border-radius: 15px;
    font-size: 0.9rem;
    margin-bottom: 0.5rem;
}

.menu-description {
    color: var(--text-light);
    margin: 0.5rem 0;
    font-size: 0.95rem;
}

.price {
    font-size: 1.4rem;
    font-weight: bold;
    color: var(--pink-rose);
    margin: 1rem 0;
}

/* Café Info Section */
.cafe-info {
    background: linear-gradient(135deg, var(--white) 0%, var(--pink-light) 100%);
    padding: 4rem 0;
    margin: 4rem 0;
    position: relative;
}

.cafe-info::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 5px;
    background: repeating-linear-gradient(
        90deg,
        var(--pink) 0px,
        var(--pink) 10px,
        transparent 10px,
        transparent 20px
    );
}

.info-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
    margin-top: 2rem;
}

.info-item {
    text-align: center;
    padding: 2rem;
    background: var(--white);
    border-radius: 20px;
    box-shadow: var(--shadow);
    transition: transform 0.3s;
}

.info-item:hover {
    transform: translateY(-3px);
}

.info-icon {
    font-size: 2.5rem;
    margin-bottom: 1rem;
}

.info-item h3 {
    color: var(--pink-dark);
    margin-bottom: 0.5rem;
}

/* Form Styles */
.booking-form {
    max-width: 600px;
    margin: 2rem auto;
    padding: 2.5rem;
    background: var(--white);
    border-radius: 25px;
    box-shadow: var(--shadow);
    border: 2px solid var(--border-color);
    position: relative;
}

.booking-form::before {
    content: '♡';
    position: absolute;
    top: -20px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--white);
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--pink-rose);
    font-size: 1.5rem;
    box-shadow: var(--shadow);
}

.form-group {
    margin-bottom: 1.5rem;
}

.form-group label {
    display: block;
    margin-bottom: 0.5rem;
    font-weight: 500;
    color: var(--pink-dark);
}

.form-group input,
.form-group select,
.form-group textarea {
    width: 100%;
    padding: 0.8rem 1rem;
    border: 2px solid var(--border-color);
    border-radius: 15px;
    font-size: 1rem;
    transition: all 0.3s;
    background: var(--cream);
}

.form-group input:focus,
.form-group select:focus,
.form-group textarea:focus {
    outline: none;
    border-color: var(--pink);
    box-shadow: 0 0 0 3px rgba(255, 105, 180, 0.1);
}

/* Filter Section */
.filter-section {
    background: var(--white);
    padding: 1.5rem;
    border-radius: 20px;
    margin: 2rem 0;
    box-shadow: var(--shadow);
    border: 2px solid var(--border-color);
}

.filter-group {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    align-items: center;
}

.filter-group select,
.filter-group input {
    padding: 0.7rem 1rem;
    border: 2px solid var(--border-color);
    border-radius: 15px;
    font-size: 0.95rem;
    background: var(--cream);
    flex: 1;
    min-width: 200px;
}

/* Product Detail */
.product-detail {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    margin: 3rem 0;
}

.gallery {
    position: relative;
}

.main-image {
    width: 100%;
    height: 450px;
    object-fit: cover;
    border-radius: 25px;
    box-shadow: var(--shadow);
    background: linear-gradient(135deg, var(--pink-light), var(--cream));
}

.detail-info {
    padding: 2rem;
    background: var(--white);
    border-radius: 25px;
    box-shadow: var(--shadow);
    position: relative;
}

.detail-info h1 {
    color: var(--pink-dark);
    font-size: 2rem;
    margin-bottom: 0.5rem;
}

.detail-description {
    color: var(--text-light);
    margin: 1rem 0;
    line-height: 1.8;
}

.detail-price {
    font-size: 1.8rem;
    font-weight: bold;
    color: var(--pink-rose);
    margin: 1.5rem 0;
}

/* Footer */
footer {
    background: linear-gradient(135deg, var(--pink-light) 0%, var(--white) 100%);
    border-top: 2px solid var(--border-color);
    text-align: center;
    padding: 2rem 0;
    margin-top: 4rem;
    color: var(--text-light);
}

.footer-decoration {
    font-size: 1.5rem;
    margin-bottom: 1rem;
}

/* Alert Messages */
.alert {
    padding: 1rem 1.5rem;
    border-radius: 15px;
    margin: 1rem 0;
    font-weight: 500;
    animation: heartbeat 0.5s ease-in-out;
}

.alert-success {
    background: linear-gradient(135deg, #F0FFF0, #E8F5E9);
    color: #2E7D32;
    border: 2px solid #A5D6A7;
}

.alert-error {
    background: linear-gradient(135deg, #FFF0F0, #FFE4E1);
    color: #C62828;
    border: 2px solid #EF9A9A;
}

/* Coquette Decorations */
.coquette-border {
    position: relative;
    padding: 2rem;
}

.coquette-border::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    border: 3px dashed var(--border-color);
    border-radius: 20px;
    pointer-events: none;
}

/* Responsive Design */
@media (max-width: 768px) {
    .hero h1 {
        font-size: 2rem;
    }
    
    .product-detail {
        grid-template-columns: 1fr;
    }
    
    .nav-links {
        gap: 1rem;
        font-size: 0.9rem;
    }
    
    .filter-group {
        flex-direction: column;
    }
    
    .menu-grid {
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    }
    
    .ornament-ribbon::before,
    .ornament-ribbon::after {
        display: none;
    }
}

@media (max-width: 480px) {
    nav {
        flex-direction: column;
        gap: 0.5rem;
    }
    
    .nav-links {
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
    }
    
    .hero {
        padding: 3rem 0;
    }
    
    .hero h1 {
        font-size: 1.8rem;
    }
    
    .booking-form {
        padding: 1.5rem;
    }
}
